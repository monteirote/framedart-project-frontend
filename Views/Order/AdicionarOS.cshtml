<style>

    label {
        font-size: 1.5rem
    }

    .subtitulo {
        font-size: 2rem;
        font-weight: 500
    }

    .select2-selection__rendered {
        line-height: 35px !important;
    }

    .select2-container .select2-selection--single {
        height: 37px !important;
        width: 100% !important;
    }

    .select2-selection__arrow {
        height: 37px !important;
    }
</style>


<!-- MODAL QUADRO -->
<div class="modal fade" id="modalQuadro" tabindex="-1" aria-labelledby="modalQuadroLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center" id="modalQuadroLabel">Novo Quadro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-5">
                <div class="row mt-2">
                    <div class="form-group col-lg-4 col-sm-12">
                        <label for="vlAltura">Altura</label>
                        <input type="number" class="form-control" id="vlAltura" placeholder="Em centímetros">
                    </div>

                    <div class="form-group col-lg-4 col-sm-12 mt-3 mt-lg-0">
                        <label for="vlLargura">Largura</label>
                        <input type="number" class="form-control" id="vlLargura" placeholder="Em centímetros">
                    </div>

                    <div class="form-group col-lg-4 col-sm-12 mt-3 mt-lg-0">
                        <label for="exampleFormControlInput2">Quantidade</label>
                        <input type="number" class="form-control" id="vlQuantidade" placeholder="Quantidade de quadros" value="1">
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="form-group col-lg-6 col-sm-12">
                        <label for="cdFundo">Fundo</label><br />
                        <select id="cdFundo" class="form-control" style="width: 100%" hidden></select>
                        <input type="text" id="cdFundoExibicao" class="form-control" disabled style="display: none" />
                    </div>

                    <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
                        <label for="cdMoldura">Moldura</label><br />
                        <select id="cdMoldura" class="form-control" style="width: 100%; font-size: 2rem"></select>
                        <input type="text" id="cdMolduraExibicao" class="form-control" disabled style="display: none" />
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="form-group col-lg-6 col-sm-12">
                        <label for="cdVidro">Vidro</label><br />
                        <select id="cdVidro" class="form-control" style="width: 100%; font-size: 2rem"></select>
                        <input type="text" id="cdVidroExibicao" class="form-control" disabled style="display: none" />
                    </div>

                    <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
                        <label for="cdPapel">Papel</label><br />
                        <select id="cdPapel" class="form-control" style="width: 100%; font-size: 2rem"></select>
                        <input type="text" id="cdPapelExibicao" class="form-control" disabled style="display: none" />
                    </div>
                </div>

                <div class="mb-3 mt-3" id="divInputFotos">
                    <label for="inputImagem" class="form-label">Escolha as imagens</label>
                    <input type="file" class="form-control" id="inputImagem" accept="image/*" multiple>
                    <small class="text-muted">Apenas imagens (JPG, PNG, GIF, etc.).</small>
                </div>

                <div id="previewContainer" class="text-center mt-3" style="display: none;">
                    <p><strong>Prévia das Imagens:</strong></p>
                    <div id="previewImagens" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="SalvarQuadro()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="body-content mb-5">

    <h1 class="text-center text-lg-start">Adicionar Ordem de Servico</h1>

    <div class="row mt-4">
        <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
            <label for="exampleFormControlInput2">Numero da OS</label>
            <input type="text" class="form-control" id="dsNumeroOS">
        </div>

        <div class="form-group col-lg-6 col-sm-12">
            <label for="dsPrioridade">Prioridade</label><br />
            <select class="form-control" id="dsPrioridade">
                <option value="0">Selecione</option>
                <option value="low">Baixa</option>
                <option value="medium">Média</option>
                <option value="high">Alta</option>
            </select>
        </div>

        <div class="form-group col-lg-6 col-sm-12">
            <label for="cdCliente">Cliente</label><br />
            <select class="form-control" id="cdCliente"></select>
            <small>Para adicionar um cliente, clique <a href="">aqui</a></small>
        </div>

        <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
            <label for="dtEntrega">Data de Entrega</label>
            <input type="datetime" class="form-control" id="dtEntrega" placeholder="dia/mês/ano">
        </div>

    </div>


    <div class="mt-4 d-flex flex-row align-items-center">
        <p class="subtitulo m-0 me-3 mb-2">Quadros</p>
        <button class="btn-secondary" onclick="AbrirModalAdicionar()"><i class="fa fa-add"></i></button>
    </div>

    <table class="table table-striped table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tamanho (AxL)</th>
                <th>Quantidade</th>
                <th>&nbsp;</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody id="bodyTableQuadros">
            <tr><td colspan="4" style="color: red">Sem quadros adicionados</td></tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-end row mt-lg-5 mt-sm-0">
        <button class="col-sm-12 col-lg-3 btn btn-secondary p-2 mt-3 mt-lg-0" style="font-size: 1.5rem">
            Limpar campos <i class="fa fa-eraser ms-3"></i>
        </button>

        <button class="col-sm-12 col-lg-3 btn btn-primary mt-3 mt-lg-0 ms-3 ms-s-0" style="font-size: 1.5rem" onclick="SaveOrder()">
            Salvar <i class="fa fa-save ms-3"></i>
        </button>
    </div>

</div>

<script src="~/js/addOS.js" ></script>
<script>

    const defaultPlaceholder = 'Digite os 3 primeiros caracteres';
    const quadros = [];
    var imgsQuadroAtual = [];

    $(document).ready(function () {

        let date = new Date();
        let day = String(date.getDate()).padStart(2, '0');
        let month = String(date.getMonth() + 1).padStart(2, '0');
        let year = date.getFullYear();

        $('#dtEntrega').val(`${day}/${month}/${year}`);

        $('#cdCliente').select2({
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchCustomer',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term };
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

    })

    function AbrirModalAdicionar () {
        HabilitarCampos();

        $('#cdFundo').show().select2();
        $('#cdMoldura').show().select2();
        $('#cdVidro').show().select2();
        $('#cdPapel').show().select2();

        $('#cdFundoExibicao').css('display', 'none');
        $('#cdMolduraExibicao').css('display', 'none');
        $('#cdPapelExibicao').css('display', 'none');
        $('#cdVidroExibicao').css('display', 'none');

        $('#divInputFotos').show();

        IniciarSelectsModal();

        LimparCampos();

        $('#modalQuadro').modal('show');
    }

    function HabilitarCampos () {
        $('#vlAltura').prop('disabled', false);
        $('#vlLargura').prop('disabled', false);
        $('#vlQuantidade').prop('disabled', false);
        $('#cdFundo').prop('disabled', false);
        $('#cdMoldura').prop('disabled', false);
        $('#cdVidro').prop('disabled', false);
        $('#cdPapel').prop('disabled', false);
    }

    function DesabilitarCampos () {
        $('#vlAltura').prop('disabled', true);
        $('#vlLargura').prop('disabled', true);
        $('#vlQuantidade').prop('disabled', true);
        $('#cdFundo').prop('disabled', true);
        $('#cdMoldura').prop('disabled', true);
        $('#cdVidro').prop('disabled', true);
        $('#cdPapel').prop('disabled', true);
    }

    document.getElementById("inputImagem").addEventListener("change", function (event) {

        var previewContainer = document.getElementById("previewContainer");
        var previewImagens = document.getElementById("previewImagens");

        var files = event.target.files;
        imgsQuadroAtual = files;

        previewImagens.innerHTML = "";

        let qtdFotos = $('#vlQuantidade').val();

        if (typeof qtdFotos === "number" && !isNaN(qtdFotos)) {
            toastr.error('Preencha o campo quantidade antes de poder adicionar as fotos.', 'Erro ao adicionar fotos!');
            return;
        }

        if (files.length > qtdFotos) {
            toastr.error(`A quantidade de fotos adicionada (${files.length}) eh maior que a quantidade de quadros (${qtdFotos}).`, 'Erro ao adicionar fotos!');
            document.getElementById("inputImagem").value = "";
            return;
        }

        if (files.length > 0 && files.length <= qtdFotos) {
            previewContainer.style.display = "block";

            for (let i = 0; i < files.length; i++) {
                let file = files[i];

                if (file.type.startsWith("image/")) {
                    let reader = new FileReader();

                    reader.onload = function (e) {
                        let img = document.createElement("img");
                        img.src = e.target.result;
                        img.className = "img-thumbnail";
                        img.style = "width: 100px; height: auto; border-radius: 5px; margin: 5px;";

                        previewImagens.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                }
            }
        }
    });

    function ValidarQuadro (quadro) {

        var resultado = true;

        if (quadro.altura <= 0 || quadro.altura == '' || quadro.largura <= 0 || quadro.largura == '') {
            toastr.error('A altura e a largura são campos obrigatórios e devem ser números positivos', "Erro");
            resultado = false;
        }

        return resultado;
    }

    function AdicionarQuadroTabela(quadro) {
        var indexRegistro = quadros.length - 1;

        console.log(indexRegistro)

        if (indexRegistro == 0) {
            $('#bodyTableQuadros').html('');
        }

        let registroQuadro = `<tr><td>${quadro.altura}x${quadro.largura}</td><td>${quadro.quantidade}</td><td onclick="ExibirInfo(${indexRegistro})"><i class="fa-solid fa-circle-info"></i></td><td onclick="ExcluirRegistro(${indexRegistro})"><i class="fa-solid fa-trash"></i></td></tr>`;


        $('#bodyTableQuadros').append(registroQuadro);
    }

    async function SalvarQuadro() {

        let files = $('#inputImagem').prop('files');

        let imagensBase64 = await convertImagesToBase64(Array.from(files));

        let quadro = {
            altura: $("#vlAltura").val() || 0,
            largura: $("#vlLargura").val() || 0,
            quantidade: $("#vlQuantidade").val() || 0,
            fundo: {
                id: $('#cdFundo').val() || 0,
                text: $("#cdFundo option:selected").text() || '',
            },
            moldura: {
                id: $('#cdMoldura').val() || 0,
                text: $("#cdMoldura option:selected").text() || '',
            },
            vidro: {
                id: $('#cdVidro').val() || 0,
                text: $("#cdVidro option:selected").text() || '',
            },
            papel: {
                id: $('#cdPapel').val() || 0,
                text: $("#cdPapel option:selected").text() || '',
            },
            imagens: imagensBase64 
        };

        var quadroValido = ValidarQuadro(quadro);
        if (!quadroValido) return;

        quadros.push(quadro);

        AdicionarQuadroTabela(quadro);

        $('#modalQuadro').modal('hide');
        LimparCampos();
    }

    function LimparCampos() {
        $('#modalQuadro').modal('hide');

        $("#vlAltura").val("");
        $("#vlLargura").val("");
        $("#vlQuantidade").val("1");

        $("#cdFundo").val(null).trigger('change');
        $("#cdMoldura").val(null).trigger('change');
        $("#cdVidro").val(null).trigger('change');
        $("#cdPapel").val(null).trigger('change');

        $("#inputImagem").val("");

        $("#previewImagens").empty();
        $("#previewContainer").hide();
    }

    function ExibirInfo(index) {
    let quadro = quadros[index];

    console.log(quadro);

    // Preencher os campos do formulário com os dados do quadro
    $("#vlAltura").val(quadro.altura);
    $("#vlLargura").val(quadro.largura);
    $("#vlQuantidade").val(quadro.quantidade);

    $('#cdFundoExibicao').val(quadro.fundo.text);
    $('#cdFundoExibicao').css('display', 'block');
    $('#cdFundo').select2('destroy').hide();

    $('#cdMolduraExibicao').val(quadro.moldura.text);
    $('#cdMolduraExibicao').css('display', 'block');
    $('#cdMoldura').select2('destroy').hide();

    $('#cdPapelExibicao').val(quadro.papel.text);
    $('#cdPapelExibicao').css('display', 'block');
    $('#cdPapel').select2('destroy').hide();

    $('#cdVidroExibicao').val(quadro.vidro.text);
    $('#cdVidroExibicao').css('display', 'block');
    $('#cdVidro').select2('destroy').hide();

    $('#divInputFotos').hide();

    var previewContainer = document.getElementById("previewContainer");
    var previewImagens = document.getElementById("previewImagens");

    previewImagens.innerHTML = ""; 
    previewImagens.style.display = 'block';
    previewContainer.style.display = 'block';

    for (let i = 0; i < quadro.imagens.length; i++) {
        let base64Image = quadro.imagens[i]; 

        let img = document.createElement("img");
        img.src = `data:image/jpeg;base64,${base64Image}`; 
        img.className = "img-thumbnail";
        img.style = "width: 100px; height: auto; border-radius: 5px; margin: 5px;";
        previewImagens.appendChild(img); 
    }

    $("#inputImagem").css('display', 'none');

    $('#modalQuadro').modal('show');
}

    function ExcluirRegistro(index) {
        quadros.splice(index, 1);

        let quadrosHTML = document.getElementById('bodyTableQuadros');

        let item = quadrosHTML.children[index];

        if (item)
            quadrosHTML.removeChild(item);

        if (quadrosHTML.children.length == 0) {
            $('#bodyTableQuadros').html('<tr><td colspan="4" style="color: red">Sem quadros adicionados</td></tr>');
        }
    }

    function SaveOrder() {
        SubmitOrder(quadros);
    }


</script>

