<style>

    label {
        font-size: 1.5rem
    }

    .subtitulo {
        font-size: 2rem;
        font-weight: 500
    }

    .select2-selection__rendered {
        line-height: 35px !important;
    }

    .select2-container .select2-selection--single {
        height: 37px !important;
        width: 100% !important;
    }

    .select2-selection__arrow {
        height: 37px !important;
    }
</style>



<div class="modal fade" id="modalAddQuadro" tabindex="-1" aria-labelledby="modalAddQuadroLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center" id="modalAddQuadroLabel">Novo Quadro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-5">
                <div class="row mt-2">
                    <div class="form-group col-lg-4 col-sm-12">
                        <label for="vlAltura">Altura</label>
                        <input type="number" class="form-control" id="vlAltura" placeholder="Em centímetros">
                    </div>

                    <div class="form-group col-lg-4 col-sm-12 mt-3 mt-lg-0">
                        <label for="vlLargura">Largura</label>
                        <input type="number" class="form-control" id="vlLargura" placeholder="Em centímetros">
                    </div>

                    <div class="form-group col-lg-4 col-sm-12 mt-3 mt-lg-0">
                        <label for="exampleFormControlInput2">Quantidade</label>
                        <input type="number" class="form-control" id="vlQuantidade" placeholder="Quantidade de quadros" value="1">
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="form-group col-lg-6 col-sm-12">
                        <label for="cdFundo">Fundo</label><br />
                        <select id="cdFundo" class="form-control" style="width: 100%"></select>
                    </div>

                    <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
                        <label for="cdMoldura">Moldura</label><br />
                        <select id="cdMoldura" class="form-control" style="width: 100%; font-size: 2rem"></select>                    
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="form-group col-lg-6 col-sm-12">
                        <label for="cdVidro">Vidro</label><br />
                        <select id="cdVidro" class="form-control" style="width: 100%; font-size: 2rem"></select>
                    </div>

                    <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
                        <label for="cdPapel">Papel</label><br />
                        <select id="cdPapel" class="form-control" style="width: 100%; font-size: 2rem"></select>
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label for="inputImagem" class="form-label">Escolha as imagens</label>
                    <input type="file" class="form-control" id="inputImagem" accept="image/*" multiple>
                    <small class="text-muted">Apenas imagens (JPG, PNG, GIF, etc.).</small>
                </div>

                <div id="previewContainer" class="text-center mt-3" style="display: none;">
                    <p><strong>Prévia das Imagens:</strong></p>
                    <div id="previewImagens" class="d-flex flex-wrap gap-2"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="SalvarQuadro()">Salvar</button>
            </div>
        </div>
    </div>
</div>


<div class="body-content mb-5">

    <h1 class="text-center text-lg-start">Adicionar Ordem de Servico</h1>

    <div class="row mt-4">
        <div class="form-group col-lg-6 col-sm-12">
            <label for="exampleFormControlInput1">Cliente</label><br />
            <select class="form-control" id="cdCliente"></select>
            <small>Para adicionar um cliente, clique <a href="">aqui</a></small>
        </div>

        <div class="form-group col-lg-6 col-sm-12 mt-3 mt-lg-0">
            <label for="exampleFormControlInput2">Data de Entrega</label>
            <input type="datetime" class="form-control" id="dtEntrega" placeholder="dia/mês/ano">
        </div>
    </div>


    <div class="mt-4 d-flex flex-row align-items-center">
        <p class="subtitulo m-0 me-3">Quadros</p>
        <button class="btn-secondary" data-bs-toggle="modal" data-bs-target="#modalAddQuadro"><i class="fa fa-add"></i></button>
    </div>

    <table class="table table-striped table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Altura</th>
                <th>Largura</th>
                <th>Quantidade</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody id="bodyTableQuadros">
        </tbody>
    </table>


</div>

<script>

    const defaultPlaceholder = 'Digite os 3 primeiros caracteres';
    const quadros = [];

    document.getElementById("inputImagem").addEventListener("change", function (event) {
        var btnSalvar = document.getElementById("btnSalvar");
        var previewContainer = document.getElementById("previewContainer");
        var previewImagens = document.getElementById("previewImagens");

        var files = event.target.files;

        previewImagens.innerHTML = "";

        if (files.length > 0 && files.length <= 5) {
            previewContainer.style.display = "block";

            for (let i = 0; i < files.length; i++) {
                let file = files[i];

                if (file.type.startsWith("image/")) {
                    let reader = new FileReader();

                    reader.onload = function (e) {
                        let img = document.createElement("img");
                        img.src = e.target.result;
                        img.className = "img-thumbnail";
                        img.style = "width: 100px; height: auto; border-radius: 5px; margin: 5px;";

                        previewImagens.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                }
            }

            btnSalvar.disabled = false;
        } else {
            previewContainer.style.display = "none";
            btnSalvar.disabled = true;

            alert("Selecione no máximo 5 imagens.");
        }
    });

    $(document).ready(function () {

        let date = new Date();
        let day = String(date.getDate()).padStart(2, '0');
        let month = String(date.getMonth() + 1).padStart(2, '0');
        let year = date.getFullYear();

        $('#dtEntrega').val(`${day}/${month}/${year}`);

        $('#cdCliente').select2({
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchCustomer',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term }; 
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

        $('#cdFundo').select2({
            dropdownParent: $('#modalAddQuadro'),
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchMaterial',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term, type: 'Background' };
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

        $('#cdMoldura').select2({
            dropdownParent: $('#modalAddQuadro'),
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchMaterial',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term, type: 'Frame' };
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

        $('#cdPapel').select2({
            dropdownParent: $('#modalAddQuadro'),
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchMaterial',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term, type: 'Paper' };
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

        $('#cdVidro').select2({
            dropdownParent: $('#modalAddQuadro'),
            placeholder: defaultPlaceholder,
            minimumInputLength: 3,
            ajax: {
                url: '/Order/SearchMaterial',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return { text: params.term, type: 'Glass' };
                },
                processResults: function (data) {
                    return {
                        results: data.data
                    };
                },
                cache: true,
                async: true
            }
        });

    });

    function ValidarQuadro (quadro) {

        var resultado = true;

        if (quadro.altura <= 0 || quadro.altura == '' || quadro.largura <= 0 || quadro.largura == '') {
            toastr.error('A altura e a largura são campos obrigatórios e devem ser números positivos', "Erro");
            resultado = false;
        }

        if (quadro.cdFundo == 0 || quadro.cdMoldura == 0) {
            toastr.error(`Os campos 'Fundo' e 'Moldura' são obrigatórios.`, "Erro");
            resultado = false;
        }

        return resultado;
    }

    function AdicionarQuadroTabela (quadro) {
        let registroQuadro = `<tr><td>${quadro.altura}</td><td>${quadro.largura}</td><td>${quadro.quantidade}</td><td>I</td></tr>`;
        $('#bodyTableQuadros').append(registroQuadro);
    }

    function SalvarQuadro() {

        let quadro = {
            altura: $("#vlAltura").val() || 0,
            largura: $("#vlLargura").val() || 0,
            quantidade: $("#vlQuantidade").val() || 0,
            cdFundo: $('#cdFundo').val() || 0,
            cdMoldura: $('#cdMoldura').val() || 0,
            cdVidro: $('#cdVidro').val() || 0,
            cdPapel: $('#cdPapel').val() || 0,
            imagens: $("#inputImagem")[0].files
        };

        var quadroValido = ValidarQuadro(quadro);

        if (!quadroValido)
            return;

        quadros.push(quadro);

        AdicionarQuadroTabela(quadro);

        console.log(quadros);
    }

</script>

